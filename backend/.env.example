# LLM API Configuration (OpenAI-compatible)
# This app works with ANY OpenAI API-compatible provider!

# Ollama (default in devcontainer - runs as separate Docker service)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama  # Required but ignored by Ollama
LLM_MODEL=gemma3:4b

# Examples for other providers:
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1, LLM_API_KEY=lm-studio, LLM_MODEL=your-model

# Whisper Configuration (local speech-to-text)
WHISPER_MODEL=base.en

# --------------------------------------------------------------------------
# Local RAG + search over transcripts (optional, fully offline via Ollama)
# --------------------------------------------------------------------------
# Off by default. To enable: install Ollama, pull an embedding + chat model,
# install the deps (`uv sync --extra rag`), then set RAG_ENABLED=true.
#   ollama pull nomic-embed-text
#   ollama pull gemma3
RAG_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
RAG_EMBED_MODEL=nomic-embed-text
RAG_LLM_MODEL=gemma3
# Optional CrossEncoder reranking (needs `uv sync --extra rag-rerank`):
RAG_RERANK=false
# RAG_TOP_K=5
# RAG_FETCH_K=20
# RAG_VECTOR_DIR=./rag_data/chroma
# RAG_DOCS_DIR=./rag_data/docs
