{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      },
      "llmBaseUrl": {
        "value": "${LLM_BASE_URL}"
      },
      "llmApiKey": {
        "value": "${LLM_API_KEY}"
      },
      "llmModel": {
        "value": "${LLM_MODEL}"
      },
      "whisperModel": {
        "value": "${WHISPER_MODEL=base.en}"
      }
    }
}
